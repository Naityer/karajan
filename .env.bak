# KARAJAN local environment
# Leave KARAJAN_TOKEN empty to keep local mutation auth disabled.
KARAJAN_TOKEN=
KARAJAN_LOG_LEVEL=INFO
# Verifica el token de capacidad RS256 que manda Atlas (app/atlas_auth.py).
KARAJAN_REQUIRE_ATLAS_TOKEN=1
# Optional provider keys:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# ZAI_API_KEY=
# TOGETHER_API_KEY=
# OPENROUTER_API_KEY=
# HF_TOKEN=
# MOONSHOT_API_KEY=
# MISTRAL_API_KEY=
