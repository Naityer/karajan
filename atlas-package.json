{
  "schema": 1,
  "id": "karajan",
  "nombre": "Karajan",
  "version": "0.8.0",
  "tipo": "app",
  "descripcion": "Router de tareas: clasificación heurística, métricas, rendimiento por agente y analítica de skills, dentro de Atlas dev.",
  "requiere": {
    "node": ">=22.5"
  },
  "construir": [
    "node atlas/build.mjs"
  ],
  "incluye": [
    "dist-atlas/**"
  ],
  "servidor": {
    "entrada": "dist-atlas/server.mjs"
  },
  "ui": {
    "bundle": "dist-atlas/ui.js",
    "estilos": "dist-atlas/ui.css",
    "ventana": {
      "etiqueta": "Karajan",
      "icono": "cpu",
      "panel": true,
      "pagina": true
    }
  }
}
